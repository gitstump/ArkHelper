# ArkHelper Caddy site block.
# This is a copy of the live config at /etc/caddy/Caddyfile on the droplet.
# Caddy terminates TLS and reverse-proxies arkhelper.info + www to accounts :8793.
# Hashed /data/<name>.<12-hex>.json files are served by Node from a boot-time
# memory map (files under 5 MB). The header matcher restates the immutable cache
# policy on those responses so Cloudflare can keep them for a year. Node sends
# the same Cache-Control, so this block is defence in depth, not a requirement.
#
# After editing the live file: caddy validate --config /etc/caddy/Caddyfile
# then systemctl reload caddy. Keep this copy in sync by hand — nothing
# automates it.

arkhelper.info, www.arkhelper.info {
        @hashed_data path_regexp hashed_data ^/data/[^/]+\.[a-f0-9]{12}\.json$
        header @hashed_data Cache-Control "public, max-age=31536000, immutable"
        reverse_proxy localhost:8793
}